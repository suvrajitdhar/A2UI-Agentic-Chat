# ---- Agent ---------------------------------------------------------------
# hybrid (scripted demos + LLM) | mock (scripted only, no key needed) | llm (LLM only)
AGENT_MODE=hybrid
PORT=3000
HOST=0.0.0.0

# ---- LLM provider (optional in AGENT_MODE=mock) -------------------------
# gemini | claude | custom. Leave empty to auto-detect the first configured one (gemini → claude → custom).
LLM_PROVIDER=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (the SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile with LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Lower = faster first component.
CLAUDE_EFFORT=low

# Custom: any OpenAI-compatible Chat Completions endpoint (Ollama, LM Studio, vLLM, OpenRouter, OpenAI, …)
# e.g. Ollama: CUSTOM_LLM_BASE_URL=http://localhost:11434/v1  CUSTOM_LLM_MODEL=qwen2.5:14b
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_TEMPERATURE=
