{
  "name": "a2ui-agent-server",
  "version": "1.0.0",
  "description": "A2UI v0.9 agent server (SSE) for a Jetpack Compose A2UI client",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mock": "AGENT_MODE=mock node --watch server.js",
    "smoke": "node scripts/smoke.mjs",
    "test:providers": "node --test --test-timeout=20000 scripts/providers.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@google/genai": "^2.32.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  },
  "allowScripts": {
    "@google/genai@2.32.0": true,
    "protobufjs@7.6.6": true
  },
  "engines": {
    "node": ">=20"
  }
}
